DATABASE_URL=
AUTH_SECRET=
AUTH_URL=
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ローカル/CI/E2E専用。/api/test/cleanup を有効化する（TEST_CLEANUP_SECRETとの併設が必須）。
# 本番環境には絶対に設定しないこと。
ENABLE_TEST_ENDPOINTS=
# ローカル/CI/E2E専用。/api/test/cleanup の追加認証用シークレット（GATE-03、多層防御）。
# ENABLE_TEST_ENDPOINTS=trueだけでは有効化されず、この値とリクエストヘッダ
# x-test-cleanup-secret が一致した場合のみ動作する。本番環境には絶対に設定しないこと。
TEST_CLEANUP_SECRET=
# ローカル/CI/E2E専用。checkRateLimit（src/lib/rate-limit.ts）自体をバイパスする。
# 同一テストユーザーで繰り返しログインするE2E/perfが実際の攻撃と区別できず誤爆するための回避。
# ENABLE_TEST_ENDPOINTS/TEST_CLEANUP_SECRETとは意図的に別フラグ（GATE-03、片方の漏洩がもう
# 片方の効果を持たないようにする）。本番環境には絶対に設定しないこと。
DISABLE_RATE_LIMIT_FOR_TESTS=
# ローカル/CI/E2E専用。bcryptのハッシュ化コスト（デフォルト12）を下げ、
# パスワードハッシュ比較によるCPU負荷（E2Eのフレーク要因）を減らす。
# 本番環境には絶対に設定しないこと（コストを下げるとパスワードの総当たり耐性が下がる）。
BCRYPT_COST=
# パフォーマンステスト（.env.perf）専用。Playwrightのwebserverを無効化し、
# perf:start済みのサーバーに直接接続させる（開発DBに誤って接続するのを防ぐ）。
PERF=
