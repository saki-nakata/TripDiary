DATABASE_URL=
AUTH_SECRET=
AUTH_URL=
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# pino（src/lib/logger.ts）のログレベル。未設定時は本番はinfo、それ以外はdebugを既定値とする。
# 例: debug/info/warn/error
LOG_LEVEL=
# ローカル/CI/E2E専用。/api/test/cleanup を有効化する（TEST_CLEANUP_SECRETとの併設が必須）。
# 本番環境には絶対に設定しないこと。
ENABLE_TEST_ENDPOINTS=
# ローカル/CI/E2E専用。/api/test/cleanup の追加認証用シークレット（GATE-03、多層防御）。
# ENABLE_TEST_ENDPOINTS=trueだけでは有効化されず、この値とリクエストヘッダ
# x-test-cleanup-secret が一致した場合のみ動作する。本番環境には絶対に設定しないこと。
TEST_CLEANUP_SECRET=
# ローカル/CI/E2E専用。checkRateLimit（src/lib/rate-limit.ts）自体をバイパスする。
# 同一テストユーザーで繰り返しログインするE2E/perfが実際の攻撃と区別できず誤爆するための回避。
# ENABLE_TEST_ENDPOINTS/TEST_CLEANUP_SECRETとは意図的に別フラグ（GATE-03、片方の漏洩がもう
# 片方の効果を持たないようにする）。本番環境には絶対に設定しないこと。
DISABLE_RATE_LIMIT_FOR_TESTS=
# ローカル/CI/E2E専用。bcryptのハッシュ化コスト（デフォルト12）を下げ、
# パスワードハッシュ比較によるCPU負荷（E2Eのフレーク要因）を減らす。
# 本番環境には絶対に設定しないこと（コストを下げるとパスワードの総当たり耐性が下がる）。
BCRYPT_COST=
# パフォーマンステスト（.env.perf）専用。Playwrightのwebserverを無効化し、
# perf:start済みのサーバーに直接接続させる（開発DBに誤って接続するのを防ぐ）。
PERF=
# 開発時専用。モバイル実機等からLAN経由で開発サーバーにアクセスして動作確認する場合のみ、
# そのLAN IP（例: 192.168.1.6）を設定する（next.config.tsのallowedDevOrigins）。
# 個人のネットワーク環境依存の値のため、リポジトリには固定値を残さない。
DEV_ALLOWED_ORIGIN=
# 6-B2本番シード専用。scripts/fetch-seed-images.ts（Pexels APIから画像収集する一回限りのツール）
# のみが使用する。本番アプリの実行経路には含まれない。
PEXELS_API_KEY=
# 6-Cデモ動画撮影専用（.env.demo）。Playwrightのwebserverを無効化し、DEMO_BASE_URLへ直接接続する。
DEMO=
# デモ撮影の対象がローカル(local)か本番(production)かを明示する。本番書き込みの誤実行防止のため
# DEMO_BASE_URLと突き合わせて検証する（e2e/demo/support/guard.ts）。
DEMO_TARGET=
# DEMO_TARGET=production時のみ必須。本番デモアカウントへの書き込みを伴うことの明示的な確認。
CONFIRM_PRODUCTION_DEMO=
# デモ撮影の接続先URL。ローカルはhttp://localhost:3000、本番はhttp://54.248.13.248
DEMO_BASE_URL=
# 常設デモアカウント（seed-demo-user）のログイン情報。パスワードはprisma/seed-production.ts
# 実行時に標準出力にのみ表示されるため、リポジトリはもちろんこのファイルにも値を書かない。
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
# 投稿作成デモでアップロードする実写真2枚（seed-images配下の実在ファイルへの絶対パス）。
DEMO_UPLOAD_IMAGE_PATH=
DEMO_UPLOAD_IMAGE_PATH_2=
# いいね・コメント対象の投稿ID。DEMO_TARGET=productionではフォールバックせず必須（誤爆防止）。
DEMO_TARGET_POST_ID=
# フォロー対象のニックネーム。DEMO_TARGET=productionではフォールバックせず必須（誤爆防止）。
DEMO_FOLLOW_TARGET_NICKNAME=
